{
  "schemaVersion": 1,
  "id": "crux-go-rules",
  "displayName": "CRUX Go Rules",
  "category": "Technology Rules",
  "kind": "rule-pack",
  "version": "1.1.0",
  "lastReviewed": "2026-09-16",
  "versionPolicy": "Detect the repository language, framework, runtime, and toolchain versions before applying guidance. Preserve supported project conventions, avoid deprecated APIs in new code, and propose migrations separately with compatibility and rollback notes.",
  "references": [
    "https://go.dev/doc/effective_go",
    "https://go.dev/doc/security/fuzz/"
  ],
  "agents": [
    "codex",
    "claude-code",
    "copilot",
    "cursor",
    "gemini",
    "generic"
  ],
  "permissions": {
    "filesystem": "read",
    "network": false,
    "scripts": false,
    "hooks": false,
    "authentication": false
  },
  "license": "MIT",
  "required": false,
  "explicitOnly": false
}
